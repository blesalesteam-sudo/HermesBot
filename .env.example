# Ejemplo de las variables que hay que poner en Railway (pestaña "Variables" de cada servicio).
# No pongas claves reales en este archivo.

# ── Las dos piezas comparten esta clave interna (inventa una larga, de 32 letras o más) ──
HERMES_INTERNAL_TOKEN=cambia-esto-por-una-clave-larga-y-aleatoria

# ── Servicio hermes-core ──
# No necesita nada más. El modelo de IA y su clave se eligen dentro de la aplicación
# (Ajustes → Modelo de IA).

# ── Servicio hermesbot-web ──
HERMES_CORE_URL=ws://hermes-core.railway.internal:8080/gateway
SESSION_SECRET=otra-clave-larga-y-aleatoria
DATA_DIR=/data
# Código de estreno: te lo pide la web la primera vez, para crear la cuenta de administrador.
SETUP_CODE=inventa-un-codigo

# Los usuarios, los bots, el modelo de IA y las copias de seguridad NO se configuran aquí:
# se gestionan dentro de la aplicación, en Ajustes.
