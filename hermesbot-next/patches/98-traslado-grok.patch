 import { redactSecretsInText } from "../shared/redact.ts";
 import { readGrokChat } from "./grok-local.ts";
 import type { SetupMachine } from "./setup-import.ts";
@@ -85,3 +85,25 @@ export function importGrokHistory(store: GrokHistoryStore, machine: SetupMachine
   store.importTranscript(task.threadId, messages, messages.at(-1)!.id);
   return { messages: messages.length };
 }
+
+/** OpenBot: the same record as importGrokHistory, from chat lines the person brought in a file (the Mac exporter reads
+ * them from the Grok Bot app there), for a server that cannot look at that computer, such as a hosted one. Lines are
+ * untrusted: redacted, in time order, as a record only. Asked again, it finds that thread and adds nothing. */
+export function importGrokChatLines(store: GrokHistoryStore, botId: string, lines: readonly GrokChatLine[]): GrokHistoryAnswer | null {
+  const bot = store.bot(botId);
+  if (!bot) return null;
+  const earlier = bot.tasks?.find((task) => task.title === GROK_HISTORY_TITLE);
+  const kept = earlier ? store.messagesFor(earlier.threadId).length : 0;
+  if (kept) return { messages: kept };
+  const messages: Message[] = [];
+  for (const [index, line] of [...lines].sort((a, b) => a.at - b.at).entries()) {
+    const text = redactSecretsInText(line.text.trim());
+    if (!text) continue;
+    messages.push({ id: `grok-${index + 1}`, kind: "text", role: line.role === "user" ? "user" : "bot", text, at: line.at, parentId: messages.at(-1)?.id ?? null });
+  }
+  if (!messages.length) return { reason: "empty" };
+  const task = earlier ?? store.createTask(botId, GROK_HISTORY_TITLE);
+  if (!task) return null;
+  store.importTranscript(task.threadId, messages, messages.at(-1)!.id);
+  return { messages: messages.length };
+}
