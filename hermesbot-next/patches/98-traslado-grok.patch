+import { describe, expect, it } from "vitest";
+
+import { GROK_HISTORY_TITLE, importGrokChatLines, type GrokHistoryStore } from "./grok-history.ts";
+import type { Message } from "./store.ts";
+
+function fakeStore() {
+  const tasks: Array<{ threadId: string; title: string }> = [];
+  const threads = new Map<string, Message[]>();
+  const store = {
+    bot: (id: string) => (id === "b1" ? { id, tasks } : undefined),
+    createTask: (_bot: string, title: string) => { const task = { threadId: `t${tasks.length + 1}`, title }; tasks.push(task); return task; },
+    importTranscript: (threadId: string, messages: Message[]) => { threads.set(threadId, messages); },
+    messagesFor: (threadId: string) => threads.get(threadId) ?? [],
+  } as unknown as GrokHistoryStore;
+  return { store, tasks, threads };
+}
+
+describe("importGrokChatLines (OpenBot)", () => {
+  it("brings the lines into one thread, in time order, once", () => {
+    const { store, tasks, threads } = fakeStore();
+    expect(importGrokChatLines(store, "b1", [{ role: "bot", text: "hola", at: 2 }, { role: "user", text: "buenas", at: 1 }])).toEqual({ messages: 2 });
+    expect(tasks).toEqual([{ threadId: "t1", title: GROK_HISTORY_TITLE }]);
+    expect(threads.get("t1")!.map((m) => [m.role, m.text, m.parentId])).toEqual([["user", "buenas", null], ["bot", "hola", "grok-1"]]);
+    expect(importGrokChatLines(store, "b1", [{ role: "user", text: "otra", at: 3 }])).toEqual({ messages: 2 });
+    expect(tasks).toHaveLength(1);
+  });
+
+  it("answers null for a bot that isn't here", () => {
+    expect(importGrokChatLines(fakeStore().store, "nope", [{ role: "user", text: "x", at: 1 }])).toBeNull();
+  });
+});
