+import { describe, expect, it } from "vitest";
+
+import { grokMovePlan, mergeGrokBots, parseGrokExport } from "./grok-import.ts";
+
+// OpenBot: what the Mac exporter (traslado-grok/exportar.mjs) adds to an export: how each Bot looks and its chat.
+const doc = (bot: Record<string, unknown>) => JSON.stringify({ format: "grok-bot-export", version: 1, bots: [bot] });
+
+describe("Grok Bot move with look and chat", () => {
+  it("reads the look and the chat lines, and the plan keeps both", () => {
+    const [bot] = parseGrokExport(doc({
+      name: "Tareas", instructions: "Apunta tareas.", look: { shape: "hexagon", color: "blue" },
+      chat: [{ role: "bot", text: "Hecho", at: 20 }, { role: "user", text: "Apunta esto", at: 10 }, { role: "system", text: "x", at: 5 }, { role: "user", text: "", at: 6 }],
+    }));
+    expect(bot!.look).toEqual({ shape: "hexagon", color: "blue" });
+    expect(bot!.chat).toEqual([{ role: "bot", text: "Hecho", at: 20 }, { role: "user", text: "Apunta esto", at: 10 }]);
+    const plan = grokMovePlan(bot!);
+    expect(plan.document.package.agents[0]!.appearance).toEqual({ color: "blue", mascotBody: "hexagon" });
+    expect(plan.chat).toHaveLength(2);
+  });
+
+  it("drops a shape or colour this app doesn't have and keeps its own pick", () => {
+    const [bot] = parseGrokExport(doc({ name: "A", instructions: "x", look: { shape: "pumpkin", color: "violet" } }));
+    expect(bot!.look).toBeUndefined();
+    expect(grokMovePlan(bot!).document.package.agents[0]!.appearance.mascotBody).toBeUndefined();
+  });
+
+  it("joins a chat split over two files in time order", () => {
+    const parts = [
+      ...parseGrokExport(doc({ name: "A", instructions: "x", chat: [{ role: "user", text: "dos", at: 2 }] })),
+      ...parseGrokExport(doc({ name: "A", instructions: "x", chat: [{ role: "user", text: "uno", at: 1 }, { role: "user", text: "dos", at: 2 }] })),
+    ];
+    expect(mergeGrokBots(parts)[0]!.chat!.map((line) => line.text)).toEqual(["uno", "dos"]);
+  });
+});
