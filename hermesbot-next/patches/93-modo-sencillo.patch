+/** OpenBot: browsers that an earlier default started in Advanced move to Simple once. After that the stored choice is
+ * the person's own (Settings), and it is never touched again. */
+const SIMPLE_DEFAULT_MARK = "openbot-simple-default";
+function moveToSimpleOnce(store: Storage | undefined): void {
+  try {
+    if (!store || store.getItem(SIMPLE_DEFAULT_MARK)) return;
+    store.setItem(SIMPLE_DEFAULT_MARK, "1");
+    if (store.getItem(ADVANCED_MODE_KEY) === "1") store.setItem(ADVANCED_MODE_KEY, "0");
+  } catch {
+    // Storage that cannot be written keeps whatever it holds.
+  }
+}
+
 export function readAdvancedMode(): boolean {
   if (SIMPLE_ONLY) return false;
   if (sessionChoice !== undefined) return sessionChoice;
   try {
     const store = storage();
+    moveToSimpleOnce(store);
     const stored = store?.getItem(ADVANCED_MODE_KEY);
     if (stored === "1") return true;
     if (stored === "0") return false;
-    // OpenBot: a new browser starts in Advanced mode, like the desktop app it replaces (field on its own line, model
