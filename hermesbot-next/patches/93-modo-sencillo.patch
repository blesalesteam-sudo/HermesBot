-    return true;
+    // OpenBot: a new browser starts in Simple mode, the look the app is meant to have (one-line message box, the bot's
+    // name in a pill, bots as tiles). Settings → Modo avanzado still turns the extra controls on, and that sticks.
+    return false;
   } catch {
     return false;
   }
