diff -ruN a/src/styles.css b/src/styles.css
--- a/src/styles.css	2026-11-27 11:11:41
+++ b/src/styles.css	2026-11-27 11:15:51
@@ -4029,3 +4029,33 @@
 }
 /* OpenBot: the page card someone was just taken to stands out for a moment. */
 [data-app][data-page-found] > div { box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 55%, transparent), 0 1px 4px rgb(0 0 0 / 0.05); transition: box-shadow 200ms; }
+
+/* OpenBot: the message box and the chat header's pills are frosted glass: the conversation shows through them, blurred,
+   and fades out under the box instead of stopping at its top edge. */
+[data-composer-backdrop] {
+  background: linear-gradient(to bottom, transparent 0%, transparent 50%, var(--color-app) 66%);
+}
+/* With a page open the box floats over the page, as it does over the chat; the chat's own "jump to latest" stays away. */
+main:has([data-page-pane]) .chat-column-dock { z-index: 41; }
+main:has([data-page-pane]) [data-jump-latest] { display: none; }
+:root .chat-column-dock .composer-shell,
+:root[data-skin] .chat-column-dock .composer-shell {
+  background: color-mix(in srgb, var(--color-composer) 74%, transparent);
+  -webkit-backdrop-filter: blur(20px) saturate(180%);
+  backdrop-filter: blur(20px) saturate(180%);
+}
+[data-look="chat-header"] :is(button, div, a).bg-composer {
+  background: color-mix(in srgb, var(--color-composer) 72%, transparent);
+  -webkit-backdrop-filter: blur(16px) saturate(180%);
+  backdrop-filter: blur(16px) saturate(180%);
+}
+@media (prefers-reduced-transparency: reduce) {
+  [data-composer-backdrop] { background: var(--color-app); }
+  :root .chat-column-dock .composer-shell,
+  :root[data-skin] .chat-column-dock .composer-shell,
+  [data-look="chat-header"] :is(button, div, a).bg-composer {
+    background: var(--color-composer);
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+}
