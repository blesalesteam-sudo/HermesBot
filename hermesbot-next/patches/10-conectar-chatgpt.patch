+/** hermesBot: sign the server's Hermes in to a ChatGPT account from the app, with a one-time code
+ * (`hermes auth add openai-codex` prints OpenAI's device page and the code, as `codex login --device-auth` does). */
+export const HERMES_CHATGPT_SIGN_IN: DeviceSignIn = {
+  provider: "codex",
+  product: "Hermes",
+  account: "ChatGPT",
+  homeEnv: "HERMES_HOME",
+  homeDir: ".hermes",
+  loginArgs: ["auth", "add", "openai-codex", "--type", "oauth", "--no-browser"],
+  afterLogin: [
+    ["config", "set", "model.provider", "openai-codex"],
+    ["config", "set", "model.default", process.env.HERMESBOT_CHATGPT_MODEL || "gpt-6.2-sol"],
+  ],
+  install: "Install Hermes Agent on this server, then try again.",
+  failure: (output) => (/expired|timed out/i.test(output)
+    ? "The ChatGPT sign-in code expired. Start sign-in again for a new code."
+    : "ChatGPT sign-in did not finish. Check the server's connection, then try again."),
+  status: {
+    args: ["auth", "status", "openai-codex"],
+    read: (code, output) => (code !== 0 ? "unknown" : /^openai-codex: logged in\b/m.test(output) ? "signed-in" : "signed-out"),
+  },
+  logoutArgs: ["auth", "logout", "openai-codex"],
+};
+
+/** hermesBot: whether this Hermes has an AI account or key to think with, other than Nous' free tier.
+ * Reads provider names and presence only, never values. */
+export function hermesHasProvider(env: Record<string, string | undefined> = process.env): boolean {
+  const dir = env.HERMES_HOME || harnessHome("hermes", env);
+  const read = (name: string): string => { try { return readFileSync(join(dir, name), "utf8"); } catch { return ""; } };
+  try {
+    const auth = JSON.parse(read("auth.json") || "{}") as Record<string, unknown>;
+    const names = (value: unknown) => (value && typeof value === "object" ? Object.keys(value as object) : []);
+    const paid = (name: string) => name !== "nous";
+    if (names(auth.providers).some(paid) || names(auth.credential_pool).some(paid)) return true;
+  } catch {}
+  if (/^\s*api_key:\s*\S+/m.test(read("config.yaml"))) return true;
+  return /^[A-Z0-9_]*API_KEY=\S+/m.test(read(".env"));
+}
