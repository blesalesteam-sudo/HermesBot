diff --git a/src/lib/openbot.ts b/src/lib/openbot.ts
new file mode 100644
index 0000000..a4f7e4d
--- /dev/null
+++ b/src/lib/openbot.ts
@@ -0,0 +1,27 @@
+import { useEffect } from "react";
+import type { FeatureFlagConfig } from "./feature-flags";
+import { useStoreSelector } from "@/state/store-select";
+
+/** Parts of the app this installation keeps out of sight until someone turns them on in Settings → Features. Stored on
+ * the server under `features.openbot`, so everyone who uses this place sees the same app. */
+export const OPENBOT_EXTRAS = ["teamMap", "publishedApps", "announcements", "cloud", "computers"] as const;
+export type OpenbotExtra = (typeof OPENBOT_EXTRAS)[number];
+
+let current: Record<string, boolean> = {};
+
+export function extraShown(name: OpenbotExtra, config?: FeatureFlagConfig | null): boolean {
+  return (config ? config.features?.openbot : current)?.[name] === true;
+}
+
+export function useExtra(name: OpenbotExtra): boolean {
+  return useStoreSelector((state) => state.config?.features?.openbot?.[name] === true);
+}
+
+/** Mounted once at the root: keeps `extraShown` and the `data-openbot-hide` list on <html> in step with the server. */
+export function useOpenbotExtras(): void {
+  const shown = useStoreSelector((state) => state.config?.features?.openbot);
+  current = shown ?? {};
+  useEffect(() => {
+    document.documentElement.dataset.openbotHide = OPENBOT_EXTRAS.filter((name) => shown?.[name] !== true).join(" ");
+  }, [shown]);
+}
